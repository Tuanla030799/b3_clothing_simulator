{
  "name": "lituta",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "yarn workspace @lituta/client dev",
    "build": "yarn workspace @lituta/client build",
    "preview": "yarn workspace @lituta/client preview",
    "typecheck": "yarn workspace @lituta/ui typecheck && yarn workspace @lituta/client typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test": "yarn workspace @lituta/ui test && yarn workspace @lituta/client test",
    "check": "yarn typecheck && yarn lint && yarn format:check && yarn test && yarn build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vue-eslint-parser": "^10.3.0"
  },
  "packageManager": "yarn@3.8.7"
}
